#!/bin/sh
set -eu
PIPELINE_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="$PIPELINE_ROOT/src"
PIPELINE_PYTHON=$(/usr/bin/python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["python"])' "$PIPELINE_ROOT/config/pipeline.json")
exec "$PIPELINE_PYTHON" -B -m kbot_pipeline "$@"
